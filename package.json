{
  "name": "clawforge",
  "version": "0.3.0",
  "description": "Demo videos as code — YAML script → Playwright recording → AI voiceover → MP4. Built for hackathons, product demos, and AI agents.",
  "type": "module",
  "main": "src/sdk-exports.js",
  "types": "src/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/types/index.d.ts",
      "import": "./src/sdk-exports.js"
    },
    "./sdk": {
      "types": "./src/types/index.d.ts",
      "import": "./src/sdk/clawforge-sdk.js"
    },
    "./mcp": {
      "import": "./src/mcp/clawforge-mcp-server.js"
    }
  },
  "bin": {
    "clawforge": "./bin/clawforge.js",
    "clawforge-mcp": "./bin/clawforge-mcp.js"
  },
  "scripts": {
    "start": "node bin/clawforge.js",
    "example": "node bin/clawforge.js examples/demo-script.yaml",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "ai-agent",
    "video-production",
    "demo-video",
    "playwright",
    "tts",
    "edge-tts",
    "ffmpeg",
    "automation",
    "hackathon"
  ],
  "author": "Dr.solodev <contact@drsolodev.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "playwright": "^1.52.0",
    "yaml": "^2.7.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dr-SoloDev/clawforge.git"
  }
}
